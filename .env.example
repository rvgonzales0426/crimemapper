# Copy to .env and fill in.
#
# --- Browser app (Vite) ---
# Use the anon (public) key ONLY. RLS governs what it can read.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Show "Request access" (self sign-up) on the sign-in page. Off unless "true".
# Also switch Supabase Auth -> "Allow new users to sign up" to match.
VITE_ALLOW_SIGNUP=false

# --- Server-side scripts (ingest.js) ---
# The service_role key bypasses Row Level Security, so it must stay server-side.
# NEVER give these a VITE_ prefix or import them into the browser app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
